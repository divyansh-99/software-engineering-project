# Database connection
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=placement_system
MYSQL_PORT=3306

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com)
# Leave empty only for local development; all origins are allowed when unset.
CORS_ORIGIN=

# Optional bootstrap admin account for first login.
# Leave BOTH blank to disable the bootstrap login entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=
